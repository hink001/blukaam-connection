# =======================================================
# BluKaam Connection - Environment Configuration
# =======================================================

# Port for the Node.js Express server
PORT=3000

# Security secret for JWT tokens
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/Bluekamm?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Bluekamm?retryWrites=true&w=majority

# -------------------------------------------------------
# Cloudinary (Free Cloud Photo Storage & CDN)
# Sign up at: https://cloudinary.com (Free 25GB plan)
